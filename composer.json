{
    "name": "leuchtfeuer/mautic-cdn-bundle",
    "description": "TODO",
    "license": "TODO",
    "type": "mautic-plugin",
    "homepage": "https://www.Leuchtfeuer.com",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*",
        "ext-dom": "*",
        "mautic/core-lib": "^4.0|^5.0",
        "symfony/dom-crawler": "~4.4.0|~5.4.0"
    },
    "extra": {
        "install-directory-name": "MauticCdnBundle"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.4",
        "symfony/browser-kit": "^5.4",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpstan/phpstan-strict-rules": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticCdnBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticCdnBundle\\Tests\\": "Tests"
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/dennisameling/FOSOAuthServerBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/BazingaOAuthServerBundle.git"
        }
    ],
    "scripts": {
        "fix-cs": "./vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php --show-progress dots -v",
        "phpstan": "./vendor/bin/phpstan"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": false
        }
    }
}
